# App
APP_ENV=development
SECRET_KEY=your-very-long-random-secret-key-change-this

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF].supabase.co:5432/postgres

# Frontend URL (for CORS + interview link generation)
FRONTEND_URL=http://localhost:3000

# Super admin bootstrap key (set once in prod to seed the first super admin, then clear)
# After running scripts/seed_superadmin.py, this can stay empty
SUPER_ADMIN_SEED_KEY=

# LLM
GROQ_API_KEY=your-groq-api-key-here

# TTS
CARTESIA_API_KEY=your-cartesia-api-key-here

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vapi screening call integration
VAPI_API_KEY=                        # Vapi private key (from Vapi dashboard → API Keys)
VAPI_PUBLIC_KEY=                     # Vapi public key (used by browser Web SDK)
VAPI_ASSISTANT_ID=                   # Vapi assistant ID configured for pre-screening
VAPI_WEBHOOK_SECRET=                 # Shared secret — set in Vapi webhook config → send as X-Vapi-Secret header

# SMTP (optional — if empty, invitation link is returned but no email is sent automatically)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD="your-gmail-app-password"
FROM_EMAIL=you@gmail.com
